# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: command prefix (default: ?)
COMMAND_PREFIX=?

# Optional: guild ID whose custom emojis are used for mana symbols.
# Leave blank to fall back to text symbols such as {W}.
EMOJI_GUILD_ID=

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Optional: also write logs to this file (rotated at 5 MB, 3 backups).
# Leave blank to log to stdout only.
LOG_FILE=
